{
  "name": "xrayview",
  "private": true,
  "version": "0.5.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "contracts:generate": "node ./contracts/scripts/generate-contract-bindings.mjs",
    "contracts:check": "node ./contracts/scripts/generate-contract-bindings.mjs --check && node ./contracts/scripts/validate-contract-schema-rules.mjs",
    "postinstall": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev --",
    "backend:build": "GOCACHE=$PWD/backend/.gocache go build -o backend/bin/xrayview-backend ./backend/cmd/xrayview-backend",
    "backend:cli": "GOCACHE=$PWD/backend/.gocache go run ./backend/cmd/xrayview-backend --",
    "backend:test": "GOCACHE=$PWD/backend/.gocache go test ./backend/...",
    "desktop:dev": "node ./frontend/scripts/desktop-dev.mjs",
    "desktop:build": "node ./frontend/scripts/desktop-build.mjs",
    "release:smoke": "npm --prefix frontend run release:smoke --",
    "release:smoke:bundle": "npm --prefix frontend run release:smoke:bundle --",
    "playwright": "npm --prefix frontend exec playwright",
    "test:e2e": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 npm --prefix frontend exec playwright test",
    "playwright:install": "PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 npm --prefix frontend exec playwright install chromium",
    "lint": "npm run lint:go && npm run lint:ts",
    "lint:go": "GOCACHE=$PWD/backend/.gocache go vet ./backend/...",
    "lint:desktop": "GOCACHE=$PWD/desktop/.gocache go vet -tags webkit2_41 ./desktop/...",
    "lint:ts": "npm --prefix frontend run lint --"
  }
}
